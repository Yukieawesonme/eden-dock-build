diff -ruN a/src/android/app/src/main/java/org/yuzu/yuzu_emu/features/settings/model/DockedModeSetting.kt b/src/android/app/src/main/java/org/yuzu/yuzu_emu/features/settings/model/DockedModeSetting.kt
--- a/src/android/app/src/main/java/org/yuzu/yuzu_emu/features/settings/model/DockedModeSetting.kt	1970-01-01 00:00:00.000000000 +0000
+++ b/src/android/app/src/main/java/org/yuzu/yuzu_emu/features/settings/model/DockedModeSetting.kt	2026-10-15 05:07:25.722176499 +0000
@@ -0,0 +1,56 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+package org.yuzu.yuzu_emu.features.settings.model
+
+import org.yuzu.yuzu_emu.NativeLibrary
+import org.yuzu.yuzu_emu.features.input.NativeInput
+import org.yuzu.yuzu_emu.features.input.model.NpadStyleIndex
+
+/**
+ * Boolean view of the native Settings::ConsoleMode enum (Handheld = 0, Docked = 1).
+ *
+ * The native setting is a 4 byte enum, so it has to be accessed as an int rather than a bool.
+ */
+object DockedModeSetting : AbstractBooleanSetting {
+    private const val HANDHELD = 0
+    private const val DOCKED = 1
+
+    private val setting = IntSetting.USE_DOCKED_MODE
+
+    override val key = setting.key
+
+    override val defaultValue: Boolean by lazy { setting.defaultValue == DOCKED }
+
+    /**
+     * Docked mode can't be used while player 1 is a handheld controller.
+     */
+    val isAvailable: Boolean
+        get() = NativeInput.getStyleIndex(0) != NpadStyleIndex.Handheld
+
+    override fun getBoolean(needsGlobal: Boolean): Boolean {
+        if (!isAvailable) {
+            return false
+        }
+        return setting.getInt(needsGlobal) == DOCKED
+    }
+
+    override fun setBoolean(value: Boolean) {
+        val wasDocked = setting.getInt(false) == DOCKED
+        setting.setInt(if (value) DOCKED else HANDHELD)
+        if (wasDocked != value) {
+            NativeLibrary.notifyOperationModeChanged()
+        }
+    }
+
+    override fun getValueAsString(needsGlobal: Boolean): String =
+        (setting.getInt(needsGlobal) == DOCKED).toString()
+
+    override fun reset() {
+        val wasDocked = setting.getInt(false) == DOCKED
+        setting.reset()
+        if (wasDocked != (setting.getInt(false) == DOCKED)) {
+            NativeLibrary.notifyOperationModeChanged()
+        }
+    }
+}
